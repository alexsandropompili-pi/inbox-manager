# ─── Supabase ─────────────────────────────────────────────────────────────────
# Project URL — visible in: Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key — safe to expose in the browser (RLS enforces access control)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — NEVER expose client-side; used only in server-only code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic ────────────────────────────────────────────────────────────────
# API key — generate at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Ingest API ───────────────────────────────────────────────────────────────
# Secret token for the POST /api/messages/ingest endpoint.
# Generate a random string: openssl rand -hex 32
INGEST_SECRET=your-ingest-secret

# ─── App ──────────────────────────────────────────────────────────────────────
# Public URL of the app — used to build the password-reset redirect link.
# On Vercel this is set automatically via VERCEL_URL; set it explicitly only
# if you have a custom domain or need it locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
